{
  "name": "@flowjs/flow.js",
  "version": "3.0.0-alpha.1",
  "description": "Flow.js implements multiple simultaneous, stable, fault tolerant and resumable chunked uploads using the HTML5 File API.",
  "type": "module",
  "main": "dist/flow.cjs",
  "module": "src/Flow.js",
  "browser": "dist/flow.js",
  "exports": {
    ".": {
      "browser": "./dist/flow.js",
      "import": "./src/Flow.js",
      "require": "./dist/flow.cjs",
      "default": "./dist/flow.esm.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rollup -c",
    "build:test": "rollup -c rollup.test.mjs",
    "test": "npm run build:test && node scripts/run-browser-tests.mjs --browser all",
    "test:local": "npm run build:test && node scripts/run-browser-tests.mjs --browser chromium-cdp",
    "test:no-build": "node scripts/run-browser-tests.mjs --browser all",
    "test:coverage": "FLOW_COVERAGE=1 npm run build:test && node scripts/run-browser-tests.mjs --browser all --coverage && node scripts/coverage-report.mjs",
    "test:coverage:local": "FLOW_COVERAGE=1 npm run build:test && node scripts/run-browser-tests.mjs --browser chromium-cdp --coverage && node scripts/coverage-report.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "playwright:install": "playwright install --with-deps chromium firefox webkit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/flowjs/flow.js.git"
  },
  "keywords": [
    "flow.js",
    "flow",
    "resumable.js",
    "file upload",
    "resumable upload",
    "chunk upload",
    "html5 upload",
    "javascript upload",
    "upload"
  ],
  "author": "Aidas Klimas",
  "contributors": [
    "Rapha\u00ebl Droz drzraf@github"
  ],
  "license": "MIT",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/flowjs/flow.js/issues"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "devDependencies": {
    "istanbul-lib-coverage": "^3.2.0",
    "istanbul-lib-report": "^3.0.0",
    "istanbul-reports": "^3.1.5",
    "jasmine-core": "^4.6.0",
    "playwright": "^1.64.1",
    "rollup": "^3.20.2",
    "rollup-plugin-istanbul": "^3.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "sinon": "^15.0.3"
  }
}
