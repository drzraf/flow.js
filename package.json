{
  "name": "@flowjs/flow.js",
  "version": "3.0.0-alpha.1",
  "description": "Flow.js implements multiple simultaneous, stable, fault tolerant and resumable chunked uploads using the HTML5 File API.",
  "type": "module",
  "main": "dist/flow.cjs",
  "module": "src/Flow.js",
  "browser": "dist/flow.js",
  "exports": {
    ".": {
      "browser": "./dist/flow.js",
      "import": "./src/Flow.js",
      "require": "./dist/flow.cjs",
      "default": "./dist/flow.esm.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/flowjs/flow.js.git"
  },
  "keywords": [
    "flow.js",
    "flow",
    "resumable.js",
    "file upload",
    "resumable upload",
    "chunk upload",
    "html5 upload",
    "javascript upload",
    "upload"
  ],
  "author": "Aidas Klimas",
  "contributors": [
    "Rapha\u00ebl Droz drzraf@github"
  ],
  "license": "MIT",
  "readmeFilename": "README.md",
  "bugs": {
    "url": "https://github.com/flowjs/flow.js/issues"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "devDependencies": {
    "rollup": "^3.20.2",
    "rollup-plugin-terser": "^7.0.2"
  }
}
